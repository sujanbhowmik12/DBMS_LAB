CREATE TABLE Student (
    Roll NUMBER(5),
    Name VARCHAR2(30),
    Age NUMBER(5),
    Course VARCHAR2(5),
    Math NUMBER(6, 2),
    Physics NUMBER(6, 2),
    Computer NUMBER(6, 2),
    Birthday DATE
);

CREATE TABLE MSc AS 
SELECT * FROM Student 
WHERE 1 = 0;

DESC MSc;

CREATE TABLE MCA AS 
SELECT 
    Roll, 
    Name AS First_Name, 
    Age, 
    Course AS Department, 
    Math, 
    Physics, 
    Computer, 
    Birthday 
FROM Student 
WHERE 1 = 0;

DESC MCA;

